# Copy to .env. NEVER commit .env. In production, inject these from your platform's secret store.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

MONGODB_URI=mongodb://localhost:27017/business_automation
REDIS_URL=redis://localhost:6379

# API keys: "key:userId,key2:userId2". The userId must match a lead's ownerId to be allowed to move it.
# Keys must be at least 16 characters. Generate one with:  openssl rand -hex 24
# Required when NODE_ENV=production.
API_KEYS=

# Email. In production all three of SMTP_HOST/SMTP_USER/SMTP_PASS are REQUIRED (the app refuses to start
# otherwise). Outside production, leaving them empty uses DEMO mode: nothing is sent, invoices are marked sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=billing@example.com

# Requests per minute per client IP on /api (0 disables). Per process.
RATE_LIMIT_PER_MINUTE=300

# Where the worker stores invoice PDFs (must be a persistent volume in production).
# Under docker compose this is forced to /data/invoices (the persistent volume) by docker-compose.yml.
INVOICE_DIR=generated-invoices

# Copy to server/.env for local development. NEVER commit real secrets.
# In production, inject these from your platform's secret store.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database (PostgreSQL 16+) -------------------------------------------------------------
# Create roles + database once with:  bash scripts/db-setup.sh   (see the script header)
#   apex_owner : owns the schema, used ONLY by `npm run db:migrate`
#   apex_app   : used by the running API/worker; no superuser, no BYPASSRLS, not a table owner,
#                so Row-Level Security always applies. The API refuses to start with any other kind of role.
DATABASE_URL=postgres://apex_app:CHANGE_ME@localhost:5432/apexoutbox
MIGRATION_DATABASE_URL=postgres://apex_owner:CHANGE_ME@localhost:5432/apexoutbox
DB_POOL_MAX=10

# --- Tests (put in server/.env.test) -------------------------------------------------------
# Must point at a database whose name contains "test": it is wiped on every test run.
# TEST_DATABASE_URL=postgres://apex_app:CHANGE_ME@localhost:5432/apexoutbox_test
# TEST_MIGRATION_DATABASE_URL=postgres://apex_owner:CHANGE_ME@localhost:5432/apexoutbox_test

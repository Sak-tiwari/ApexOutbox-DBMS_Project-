    "nodemailer": "^10.3.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.0",
    "pino": "^10.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.10",

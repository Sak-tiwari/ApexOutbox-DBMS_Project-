# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Replica set is required for multi-document transactions (see docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/apexoutbox?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# Single-tenant for now. Every document still carries a tenantId (see docs/03-decision-log.md, D-04)
DEFAULT_TENANT_SLUG=internal

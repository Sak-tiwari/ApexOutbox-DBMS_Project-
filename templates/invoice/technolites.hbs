<!doctype html>
<!--
  Technolites IT Pvt. Ltd. - Tax Invoice template. The logo and the super.money UPI QR are embedded below
  as base64 images, so this file is fully standalone. UPI only: there is deliberately no payment link.
-->
<html lang="en"><head><meta charset="utf-8"><title>Tax Invoice {{invoice.number}}</title>
<style>
  @page { size: A4; margin: 14mm; }
  :root { --navy:#1F3E9A; --orange:#F47B20; --text:#1A1A1A; --muted:#6B7280; --line:#E5E7EB; --stripe:#F8FAFC; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #fff; color: var(--text); font: 12px/1.45 "Segoe UI", Roboto, Helvetica, Arial, sans-serif; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .page { width: 794px; max-width: 100%; margin: 0 auto; padding: 0 0 8px; }
  @media print { .page { width: auto; } }
  .bar { height: 8px; background: var(--navy); border-radius: 2px; margin-bottom: 18px; }
  .num { font-variant-numeric: tabular-nums; }
  .muted { color: var(--muted); }
  .header { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; }
  .logo { max-height: 70px; max-width: 260px; width: auto; height: auto; display: block; }
  .doc { text-align: right; }
  .doc h1 { margin: 0 0 6px; font-size: 28px; letter-spacing: .06em; color: var(--navy); font-weight: 700; }
  .doc table { margin-left: auto; border-collapse: collapse; }
  .doc td { padding: 1px 0 1px 12px; text-align: right; }
  .doc td:first-child { color: var(--muted); }
  .pill { display: inline-block; margin-top: 8px; padding: 2px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #fff; background: var(--orange); }
  .pill.paid { background: #16A34A; }
  .parties { display: flex; gap: 28px; margin: 22px 0 18px; padding-top: 14px; border-top: 1px solid var(--line); }
  .party { flex: 1; min-width: 0; overflow-wrap: anywhere; }
  .party h2 { margin: 0 0 4px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--navy); }
  .party .name { font-size: 14px; font-weight: 700; }
  table.items { width: 100%; border-collapse: collapse; margin-bottom: 18px; }
  .items thead { display: table-header-group; }
  .items th { background: var(--navy); color: #fff; padding: 8px 8px; font-size: 11px; text-align: left; letter-spacing: .03em; }
  .items td { padding: 8px; border-bottom: 1px solid var(--line); vertical-align: top; overflow-wrap: anywhere; }
  .items tr { page-break-inside: avoid; break-inside: avoid; }
  .items tbody tr:nth-child(even) td { background: var(--stripe); }
  .items .c { text-align: center; width: 34px; } .items .r { text-align: right; white-space: nowrap; }
  .bottom { display: flex; gap: 28px; align-items: flex-start; page-break-inside: avoid; break-inside: avoid; }
  .pay { flex: 1; min-width: 0; }
  .pay h2, .totals h2 { margin: 0 0 6px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--navy); }
  .qr { display: block; width: 130px; height: 130px; object-fit: contain; border: 1px solid var(--line); padding: 4px; background: #fff; }
  .cap { margin: 4px 0 8px; font-size: 11px; color: var(--muted); }
  .totals { width: 300px; }
  .totals table { width: 100%; border-collapse: collapse; }
  .totals td { padding: 4px 0; } .totals td:last-child { text-align: right; }
  .totals tr.sep td { border-top: 1px solid var(--line); }
  .due { margin-top: 8px; padding: 10px 12px; background: #FFF3E8; border: 1px solid var(--orange); border-radius: 4px; display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: 15px; }
  .due span:first-child { color: var(--navy); }
  .words { margin-top: 6px; font-size: 11px; color: var(--muted); }
  .notes { margin-top: 20px; page-break-inside: avoid; break-inside: avoid; }
  .notes h2 { margin: 0 0 4px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--navy); }
  .notes p { margin: 0 0 6px; font-size: 11px; color: var(--muted); overflow-wrap: anywhere; }
  .footer { margin-top: 22px; border-top: 2px solid var(--orange); padding-top: 12px; page-break-inside: avoid; break-inside: avoid; }
  .foot-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; }
  .thanks { font-weight: 700; color: var(--navy); font-size: 13px; }
  .sign { text-align: right; min-width: 200px; }
  .sign .space { height: 48px; border-bottom: 1px solid var(--line); margin-bottom: 4px; }
  .small { margin-top: 10px; text-align: center; font-size: 10px; color: var(--muted); }
</style></head>
<body><div class="page">
  <div class="bar"></div>

  <div class="header">
    <div><img class="logo" src="data:image/png;base64," alt="Technolites IT Pvt. Ltd."></div>
    <div class="doc">
      <h1>TAX INVOICE</h1>
      <table>
        <tr><td>Invoice No.</td><td><b class="num">{{invoice.number}}</b></td></tr>
        <tr><td>Date</td><td class="num">{{invoice.date}}</td></tr>
        {{#if invoice.due_date}}<tr><td>Due Date</td><td class="num">{{invoice.due_date}}</td></tr>{{/if}}
      </table>
      {{#if invoice.status}}{{#if invoice.is_paid}}<span class="pill paid">{{invoice.status}}</span>{{else}}<span class="pill">{{invoice.status}}</span>{{/if}}{{/if}}
    </div>
  </div>

  <div class="parties">
    <div class="party">
      <h2>From</h2>
      <div class="name">{{business.name}}</div>
      {{#if business.address}}<div>{{business.address}}</div>{{/if}}
      {{#if business.gstin}}<div><span class="muted">GSTIN</span> <span class="num">{{business.gstin}}</span></div>{{/if}}
      {{#if business.email}}<div>{{business.email}}</div>{{/if}}
      {{#if business.phone}}<div>{{business.phone}}</div>{{/if}}
    </div>
    <div class="party">
      <h2>Bill To</h2>
      <div class="name">{{client.name}}</div>
      {{#if client.company}}<div>{{client.company}}</div>{{/if}}
      {{#if client.address}}<div>{{client.address}}</div>{{/if}}
      {{#if client.gstin}}<div><span class="muted">GSTIN</span> <span class="num">{{client.gstin}}</span></div>{{/if}}
      {{#if client.email}}<div>{{client.email}}</div>{{/if}}
    </div>
  </div>

  <table class="items">
    <thead><tr><th class="c">#</th><th>Description</th><th class="r">Qty</th><th class="r">Rate</th><th class="r">Tax %</th><th class="r">Amount</th></tr></thead>
    <tbody>
      {{#each items}}<tr><td class="c num">{{no}}</td><td>{{description}}</td><td class="r num">{{qty}}</td><td class="r num">{{rate}}</td><td class="r num">{{tax_rate}}</td><td class="r num">{{amount}}</td></tr>
      {{/each}}
    </tbody>
  </table>

  <div class="bottom">
    <div class="pay">
      <h2>Payment</h2>
      <img class="qr" src="data:image/png;base64," alt="UPI QR"><div class="cap">Scan &amp; Pay using any UPI app</div>
      <div><span class="muted">UPI ID</span> saksham.tiwari.1@superyes</div>
      <div><span class="muted">Payee</span> Saksham Tiwari</div>
      {{#if payment.has_bank}}<div style="margin-top:8px"><span class="muted">Bank</span> {{payment.bank_name}}<br><span class="muted">A/C</span> <span class="num">{{payment.account}}</span><br><span class="muted">IFSC</span> <span class="num">{{payment.ifsc}}</span></div>{{/if}}
    </div>
    <div class="totals">
      <table class="num">
        <tr><td class="muted">Subtotal</td><td>{{totals.subtotal}}</td></tr>
        {{#if totals.has_discount}}<tr><td class="muted">Discount</td><td>- {{totals.discount}}</td></tr>{{/if}}
        {{#if tax.is_intra}}<tr><td class="muted">CGST ({{tax.cgst_rate}})</td><td>{{totals.cgst}}</td></tr>
        <tr><td class="muted">SGST ({{tax.sgst_rate}})</td><td>{{totals.sgst}}</td></tr>{{/if}}
        {{#if tax.is_inter}}<tr><td class="muted">IGST ({{tax.igst_rate}})</td><td>{{totals.igst}}</td></tr>{{/if}}
      </table>
      <div class="due num"><span>Amount Due</span><span>{{totals.total}}</span></div>
      <div class="words">Amount in words: {{totals.amount_in_words}}</div>
    </div>
  </div>

  <div class="notes">
    {{#if invoice.notes}}<h2>Notes</h2><p>{{invoice.notes}}</p>{{/if}}
    <h2>Terms</h2>
    <p>Payment due within 15 days. Late payments may attract interest as per applicable law. This is a computer-generated invoice.</p>
  </div>

  <div class="footer">
    <div class="foot-row">
      <div class="thanks">Thank you for your business!</div>
      <div class="sign"><div class="muted" style="font-size:11px">For Technolites IT Pvt. Ltd.</div><div class="space"></div><div style="font-size:11px">Authorised Signatory</div></div>
    </div>
    <div class="small">{{business.name}}{{#if business.email}} &middot; {{business.email}}{{/if}}{{#if business.phone}} &middot; {{business.phone}}{{/if}}</div>
  </div>
</div></body></html>
